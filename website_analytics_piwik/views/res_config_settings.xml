<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="google_analytics_dashboard_setting" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="website_analytics_piwik_settings">
                    <div class="o_setting_right_pane">
                    <label for="piwik_analytics_id" string="Piwik Analytics"/>
                    <div class="text-muted">Track website users using piwik</div>
                    <div class="content-group">
                        <div class="row">
                            <label class="col-lg-3 o_light_label" for="piwik_analytics_id" />
                            <field name="piwik_analytics_id" />
                        </div>
                        <div class="row">
                            <label class="col-lg-3 o_light_label" for="piwik_analytics_host" />
                            <field name="piwik_analytics_host" placeholder="host.name/piwik" />    
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
